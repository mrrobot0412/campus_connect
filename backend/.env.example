# Server Configuration
PORT=8000

# MongoDB


# JWT Secret (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Teacher emails that should receive admin permissions after login
ADMIN_EMAILS=admin.teacher@thapar.edu

# Gmail SMTP Credentials (App Password, not your regular password)
gmail_user=your-email@gmail.com
gmail_key=your-app-password

# Frontend URL(s) for CORS and password reset emails
# Use a comma-separated list for multiple production and preview origins.
FRONTEND_URLS=http://localhost:5173,https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=
